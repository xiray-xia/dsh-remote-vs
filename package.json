{
  "name": "dsh-remote-vs",
  "description": "VSCode-style remote development for DSH: SSH host manager (key/password), helper deploy pipeline with version check, remote file explorer + editor + terminal in dsh-better-sidebar.",
  "version": "0.9.1",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ssh",
    "sftp",
    "remote-development",
    "remote-editor",
    "terminal",
    "vscode"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./p2-bridge": {
      "types": "./lib/types/p2/bridge.d.ts",
      "default": "./lib/p2-bridge.js"
    },
    "./p2-bridge-refs": {
      "types": "./lib/types/p2/bridge-refs.d.ts",
      "default": "./lib/p2-bridge-refs.js"
    },
    "./p2-router-fs": {
      "types": "./lib/types/p2/router-fs.d.ts",
      "default": "./lib/p2-router-fs.js"
    },
    "./p2-router-subprocess": {
      "types": "./lib/types/p2/router-subprocess.d.ts",
      "default": "./lib/p2-router-subprocess.js"
    },
    "./p2-router-spill": {
      "types": "./lib/types/p2/router-spill.d.ts",
      "default": "./lib/p2-router-spill.js"
    },
    "./p2-router-refs": {
      "types": "./lib/types/p2/router-refs.d.ts",
      "default": "./lib/p2-router-refs.js"
    },
    "./p2-shell-bash": {
      "types": "./lib/types/p2/shell-bash.d.ts",
      "default": "./lib/p2-shell-bash.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "engines": {
    "dsh": ">=0.2.1-alpha.3 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "src",
    "vendor/dsh-remote-helpers/*",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "icon.svg",
    "locale/*.json"
  ],
  "author": "xiray-xia",
  "license": "MIT",
  "homepage": "https://github.com/xiray-xia/dsh-remote-vs#readme",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiray-xia/dsh-remote-vs.git"
  },
  "bugs": {
    "url": "https://github.com/xiray-xia/dsh-remote-vs/issues"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/search": "6.5.11",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@deepseek-ai/dsh-fs-ssh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-ssh": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@lezer/highlight": "1.2.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ws": "^8.18.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.2",
    "@deepseek-ai/dsh-agent-preset": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-bash-local": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-file-reference": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-shell": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-spill": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-bash-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.2",
    "@deepseek-ai/dsh-file-reference": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-directory-picker": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.2",
    "@deepseek-ai/dsh-spill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.1-rc.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.5.13",
    "jsdom": "^30.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsdown",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  }
}
