node_modules/
# lib/ IS committed, and that is load-bearing: the package has no `prepare`
# script any more (pnpm 12 refuses to run one for a git dependency until the
# user approves build scripts in their profile), so a `github:` install
# receives the repository exactly as it is — an uncommitted build would ship an
# empty plugin. Source maps stay out: 4.7 MB per client change is not worth
# keeping in history, and nothing loads them.
lib/**/*.map
dist/
*.tsbuildinfo
.DS_Store
# Development-only trees. The published repository holds exactly what a user
# needs to INSTALL and RUN the plugin (lib/, src/, vendor/, locale/,
# cordis.patch.yml, icon.svg, the READMEs, LICENSE, package.json + build
# config). Everything used only to develop and verify it stays on disk:
#   .spike/    real-host and jsdom probes
#   scripts/   the self-check gates (`node scripts/check-*.mjs`)
#   docs/      local working docs (everything except docs/media/)
#   CODE-REVIEW*.md
.spike/
scripts/
# Local-only working docs (never push to GitHub; see MAINTENANCE §9).
# Directory-level rule on purpose: a NEW local doc must not leak internal
# identifiers just because someone forgot to add it here. `docs/media/` holds
# the screenshots the README links, so it ships.
docs/*
!docs/media/
!docs/media/**
# Review reports are local artifacts: they describe defects as they were
# BEFORE the fixes, i.e. a map of weaknesses for anyone reading a public
# repository. Keep them on disk, never in the tree.
CODE-REVIEW*.md
tsconfig.scratch.json
